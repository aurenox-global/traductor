# ---------------- Native (llama.cpp / whisper.cpp) ----------------
# Las fuentes de los vendor viven como submódulos git (ver .gitmodules).
# Los artefactos compilados NO se versionan: se regeneran con scripts/build_native.sh.
.nativebuild/
app/src/main/cpp/prebuilt/
prebuilt/
*.o
*.a
obj/
libs/arm64-v8a/*.a

# ---------------- Local / IDE ----------------
local.properties
.idea/
*.iml
*.iws
*.ipr
.DS_Store
.settings/
.vscode/
*.log
*.hprof

# ---------------- Keystores / secretos ----------------
*.jks
*.keystore
keystore.properties
signing.properties

# ---------------- Caches ----------------
.cache/
.tmp/
*.tmp

# ---------------- Variantes con assets generados ----------------
# Modelos bundleados para -Pbundled=true; se generan con scripts/fetch_bundled_assets.sh
app/bundled-assets/
# Motor OCR empaquetado para -Pocrbundle=true; se genera con scripts/fetch_ocr_bundle.sh
app/bundled-ocr/

# ---------------- Arnes JVM (jvmharness) ----------------
# El jar de ONNX Runtime y las clases compiladas NO se versionan (son grandes y
# se regeneran; ver jvmharness/README.md).
jvmharness/libs/
jvmharness/out/
