<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/panel_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_panel" />

        <TextView
            android:id="@+id/rowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="middle"
            android:textSize="11sp"
            android:textColor="@color/muted" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rowUse"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/settings_use"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/rowDownload"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_download"
        android:src="@drawable/ic_download"
        android:tint="@color/accent"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/rowDelete"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_delete"
        android:src="@drawable/ic_delete"
        android:tint="@color/danger"
        android:visibility="gone" />
</LinearLayout>
