<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel_soft"
    android:layout_marginTop="10dp"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/histOriginal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="3"
            android:textSize="14sp"
            android:textColor="@color/muted" />

        <ImageButton
            android:id="@+id/histSpeak"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/icon_btn_bg"
            android:contentDescription="@string/cd_speak"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_speaker"
            android:tint="@color/accent" />

        <ImageButton
            android:id="@+id/histCopy"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/icon_btn_bg"
            android:contentDescription="@string/cd_copy"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_copy"
            android:tint="@color/on_panel" />

        <ImageButton
            android:id="@+id/histUse"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/icon_btn_bg"
            android:contentDescription="@string/settings_use"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_import"
            android:tint="@color/on_panel" />
    </LinearLayout>

    <TextView
        android:id="@+id/histTranslated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/accent" />

    <TextView
        android:id="@+id/histMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        android:letterSpacing="0.02"
        android:textColor="@color/muted" />
</LinearLayout>
