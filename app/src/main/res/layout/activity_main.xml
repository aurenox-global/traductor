<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <!-- ===== Barra superior: idioma origen / swap / idioma destino / ajustes ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnSourceLang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/panel_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textColor="@color/on_panel"
            android:text="@string/detect_language" />

        <ImageButton
            android:id="@+id/btnSwap"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_swap"
            android:src="@drawable/ic_swap"
            android:tint="@color/accent" />

        <TextView
            android:id="@+id/btnTargetLang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/panel_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textColor="@color/on_panel"
            android:text="Español" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/on_panel" />
    </LinearLayout>

    <!-- ===== Panel de entrada ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="10dp">

        <EditText
            android:id="@+id/editInput"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/input_hint"
            android:textColorHint="@color/muted"
            android:textColor="@color/on_panel"
            android:textSize="18sp"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionNone|flagNoExtractUi"
            android:scrollbars="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_mic"
                android:src="@drawable/ic_mic"
                android:tint="@color/accent" />

            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_camera"
                android:src="@drawable/ic_camera"
                android:tint="@color/accent" />

            <ImageButton
                android:id="@+id/btnSpeakInput"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_speak"
                android:src="@drawable/ic_speaker"
                android:tint="@color/on_panel" />

            <ImageButton
                android:id="@+id/btnPaste"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_paste"
                android:src="@drawable/ic_paste"
                android:tint="@color/on_panel" />

            <ImageButton
                android:id="@+id/btnCopyInput"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_copy"
                android:src="@drawable/ic_copy"
                android:tint="@color/on_panel" />

            <TextView
                android:id="@+id/txtCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="12sp"
                android:textColor="@color/muted" />

            <ImageButton
                android:id="@+id/btnClearInput"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_clear"
                android:src="@drawable/ic_clear"
                android:tint="@color/muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Fila de acciones ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTranslate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/translate"
            android:textColor="@color/bg"
            app:backgroundTint="@color/accent"
            app:cornerRadius="24dp" />

        <ProgressBar
            android:id="@+id/progressTranslate"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_history"
            android:src="@drawable/ic_history"
            android:tint="@color/on_panel" />

        <ImageButton
            android:id="@+id/btnClearAll"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear_all"
            android:src="@drawable/ic_delete"
            android:tint="@color/on_panel" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="@color/muted"
        android:text="@string/status_idle" />

    <ProgressBar
        android:id="@+id/progressDownload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1000"
        android:visibility="gone" />

    <!-- ===== Panel de traducción ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="10dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/txtOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/on_panel"
                android:textIsSelectable="true"
                android:text="@string/output_hint" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <ImageButton
                android:id="@+id/btnSpeakOutput"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_speak"
                android:src="@drawable/ic_speaker"
                android:tint="@color/accent" />

            <ImageButton
                android:id="@+id/btnCopyOutput"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_copy"
                android:src="@drawable/ic_copy"
                android:tint="@color/on_panel" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAutoTts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/auto_tts"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
